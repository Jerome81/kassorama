<% content_for :title, "Kategorie anzeigen" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Kategorie anzeigen</h1>

  <%= render @article_category %>

  <%= link_to "Kategorie bearbeiten", edit_article_category_path(@article_category), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Zurück zu Kategorien", article_categories_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= button_to "Kategorie löschen", @article_category, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "w-full rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Wirklich löschen?" } %>
</div>
