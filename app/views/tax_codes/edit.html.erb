<% content_for :title, "MWSt-Code bearbeiten" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">MWSt-Code bearbeiten</h1>

  <%= render "form", tax_code: @tax_code %>

  <%= link_to "MWSt-Code anzeigen", @tax_code, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Zurück zu MWSt-Codes", tax_codes_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
