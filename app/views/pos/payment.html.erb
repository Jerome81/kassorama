<div class="mx-auto w-full max-w-7xl h-[calc(100vh-100px)] flex gap-6 px-6 pb-6 pt-24">
  <!-- Left Column: Order List -->
  <div class="w-5/12 flex flex-col">
     <div class="bg-white shadow-lg rounded-2xl overflow-hidden border border-gray-100 flex-grow flex flex-col h-full">
       <div class="bg-gray-50 border-b border-gray-200 px-6 py-4 flex items-center gap-4 relative z-10">
          <%= link_to pos_path(@cash_register), class: "flex-shrink-0 p-2 -ml-2 rounded-full hover:bg-gray-200 text-gray-600 hover:text-gray-900 transition", title: "Zurück" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
          <% end %>
          <div class="flex-grow min-w-0">
            <h2 class="text-xl font-bold text-gray-800 leading-tight">Bestellübersicht</h2>
            <% if @order.name.present? %>
              <div class="text-sm text-yellow-600 font-bold mt-0.5 truncate"><%= @order.name %></div>
            <% end %>
          </div>
       </div>
       <div class="overflow-y-auto flex-grow">
          <table class="min-w-full divide-y divide-gray-200">
             <thead class="bg-gray-50 sticky top-0 z-0">
               <tr>
                 <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Artikel</th>
                 <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Menge</th>
                 <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Gesamt</th>
               </tr>
             </thead>
             <tbody class="bg-white divide-y divide-gray-200">
                <% @order_items.each do |item| %>
                  <tr>
                    <td class="px-6 py-4">
                       <div class="text-sm font-medium text-gray-900"><%= item.article.name %></div>
                       <% if item.variant %>
                          <div class="text-xs text-gray-500"><%= item.variant.name %></div>
                       <% end %>
                    </td>
                    <td class="px-6 py-4 text-right text-sm text-gray-500 font-medium whitespace-nowrap">
                       <%= item.quantity %>
                    </td>
                    <td class="px-6 py-4 text-right text-sm font-bold text-gray-900 whitespace-nowrap">
                       <% if item.discount.to_f > 0 %>
                          <div class="text-xs text-gray-400 line-through"><%= number_to_currency((item.gross_price || (item.quantity * item.unit_price)), unit: '') %></div>
                          <%= number_to_currency(item.net_price, unit: '') %>
                       <% else %>
                          <%= number_to_currency((item.gross_price || (item.quantity * item.unit_price)), unit: '') %>
                       <% end %>
                    </td>
                  </tr>
                <% end %>
             </tbody>
          </table>
       </div>
       <div class="bg-gray-50 border-t border-gray-200 px-6 py-4 flex justify-between items-center">
           <span class="font-bold text-gray-600">Artikel gesamt:</span>
           <span class="font-bold text-gray-900"><%= @order_items.sum(&:quantity) %></span>
       </div>
     </div>
  </div>

  <!-- Right Column: Payment Controls -->
  <div class="w-7/12 flex flex-col items-center justify-start">
    <div class="bg-white shadow-lg rounded-2xl w-full max-w-2xl p-8 border border-gray-100">
    <div id="pos-flash-container" class="fixed z-50 flex flex-col gap-2" style="top: 4.5rem; left: 1.25rem;">
      <% if notice.present? %>
        <div id="notice" class="py-3 px-5 bg-green-100 border border-green-400 text-green-800 font-medium rounded-full shadow-lg flex items-center gap-2 cursor-pointer" style="transition: transform 0.5s ease-in-out, opacity 0.5s ease-in-out;" onclick="dismissPosFlash(this)">
          <span><%= notice %></span>
        </div>
      <% end %>
      <% if alert.present? %>
        <div id="alert" class="py-3 px-5 bg-red-100 border border-red-400 text-red-800 font-medium rounded-full shadow-lg flex items-center gap-2 cursor-pointer" style="transition: transform 0.5s ease-in-out, opacity 0.5s ease-in-out;" onclick="dismissPosFlash(this)">
          <span><%= alert %></span>
        </div>
      <% end %>
    </div>
    <script>
      function dismissPosFlash(el) {
        if (!el || el.dataset.dismissing) return;
        el.dataset.dismissing = "true";
        el.style.transform = "translateX(-120%)";
        el.style.opacity = "0";
        setTimeout(() => {
          el.remove();
        }, 500);
      }

      function showPosFlash(message, type = "alert") {
        let container = document.getElementById("pos-flash-container");
        if (!container) {
          container = document.createElement("div");
          container.id = "pos-flash-container";
          container.className = "fixed z-50 flex flex-col gap-2";
          container.style.top = "4.5rem";
          container.style.left = "1.25rem";
          document.body.appendChild(container);
        }

        const existing = container.querySelector(`#${type}`);
        if (existing) existing.remove();

        const bubble = document.createElement("div");
        bubble.id = type;
        if (type === "notice") {
          bubble.className = "py-3 px-5 bg-green-100 border border-green-400 text-green-800 font-medium rounded-full shadow-lg flex items-center gap-2 cursor-pointer";
        } else {
          bubble.className = "py-3 px-5 bg-red-100 border border-red-400 text-red-800 font-medium rounded-full shadow-lg flex items-center gap-2 cursor-pointer";
        }
        bubble.style.transition = "transform 0.5s ease-in-out, opacity 0.5s ease-in-out";
        bubble.onclick = function() { dismissPosFlash(this); };

        const span = document.createElement("span");
        span.textContent = message;
        bubble.appendChild(span);
        container.appendChild(bubble);

        setTimeout(() => dismissPosFlash(bubble), 5000);
      }

      (() => {
        const container = document.getElementById("pos-flash-container");
        if (!container) return;
        const bubbles = container.querySelectorAll("#notice, #alert");
        bubbles.forEach((bubble) => {
          setTimeout(() => dismissPosFlash(bubble), 5000);
        });
      })();
    </script>
    <h1 class="text-3xl font-bold text-[#2C2C2C] mb-8 text-center">Bezahlung</h1>

    <div class="space-y-6">
      <!-- Total Display -->
      <div class="flex justify-between items-end border-b pb-4">
        <span class="text-gray-500 font-medium text-lg">Zwischensumme</span>
        <span class="text-3xl font-bold text-gray-800" id="subtotal_display" data-value="<%= @total %>"><%= number_to_currency(@total, unit: '') %></span>
      </div>

      <!-- Discount Section -->
      <% unless @order.order_items.any? { |i| i.discount.to_f > 0 } %>
          <div class="bg-gray-50 p-3 rounded-lg flex items-center justify-between">
            <div class="flex items-center gap-4">
                <label class="font-medium text-gray-700">Rabatt</label>
                <div class="w-32">
                     <input type="number" id="discount_value" placeholder="0" class="focus:ring-[#FFD100] focus:border-[#FFD100] block w-full text-lg border-gray-300 rounded-md p-2" value="0">
                </div>
                <div class="flex flex-col gap-1">
                     <label class="inline-flex items-center cursor-pointer">
                       <input type="radio" name="discount_type" value="fixed" checked class="form-radio text-[#FFD100] focus:ring-[#FFD100] h-4 w-4">
                       <span class="ml-1 text-sm">CHF</span>
                     </label>
                     <label class="inline-flex items-center cursor-pointer">
                       <input type="radio" name="discount_type" value="percent" class="form-radio text-[#FFD100] focus:ring-[#FFD100] h-4 w-4">
                       <span class="ml-1 text-sm">%</span>
                     </label>
                </div>
            </div>
            
            <div class="text-red-500 font-bold text-xl" id="discount_display">- 0.00</div>
          </div>
      <% else %>
          <div class="bg-blue-50 p-3 rounded-lg text-center text-blue-600 text-sm mb-4">
             Artikelrabatte wurden angewendet. Globaler Rabatt deaktiviert.
          </div>
      <% end %>
          

       <!-- Backed Discount Code Scan -->
       <div class="text-right pt-2">
        <a href="#" id="toggle_discount_code_btn" class="text-xs text-gray-500 hover:text-[#FFD100] transition" onclick="toggleDiscountCode(event)">+ Gutschein Code</a>
      </div>
      
      <div id="discount_code_section" class="bg-gray-50 p-4 rounded-lg hidden transition-all duration-300 mt-2">
         <label class="block text-sm font-medium text-gray-700 mb-1">Gutschein Betrag</label>
         <div class="flex gap-2">
             <input type="number" id="voucher_input" placeholder="Betrag..." class="focus:ring-[#FFD100] focus:border-[#FFD100] block w-full sm:text-sm border-gray-300 rounded-md p-2">
             <button type="button" onclick="redeemVoucher()" class="bg-gray-200 hover:bg-gray-300 px-4 py-2 rounded text-gray-700 font-bold">Einlösen</button>
         </div>
      </div>

      <!-- Vouchers Display -->
      <div class="flex justify-between items-end pb-2 text-gray-500 hidden" id="vouchers_summary_row">
        <span class="font-medium">Gutscheine</span>
        <span class="text-xl font-bold text-gray-800">- <span id="vouchers_display">0.00</span></span>
      </div>



      <!-- Trinkgeld Section -->
      <% if @tip_article %>
      <div class="bg-gray-50 p-4 rounded-lg mb-4 border border-gray-200">
         <div class="flex items-center justify-between mb-2">
             <h3 class="font-bold text-gray-700">Trinkgeld</h3>
         </div>
         <div class="flex gap-4 items-end">
             <%= form_with url: save_free_price_item_pos_path(@cash_register), method: :post, id: "tip_form", class: "flex gap-2 items-end flex-grow" do |f| %>
                 <%= hidden_field_tag :article_id, @tip_article.id %>
                 <%= hidden_field_tag :return_to, 'payment' %>
                 <%= hidden_field_tag :section_id, params[:section_id] if params[:section_id] %>
                 
                 <div class="w-1/3">
                     <label class="block text-xs font-medium text-gray-500 mb-1">Betrag</label>
                     <div class="relative">
                        <input type="number" name="price" id="tip_amount" step="0.05" class="w-full border-gray-300 rounded p-2 focus:ring-[#FFD100] focus:border-[#FFD100]" placeholder="0.00">
                        <span class="absolute right-8 top-2 text-gray-400 text-sm">CHF</span>
                     </div>
                 </div>
                 
                 <button type="submit" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded border border-gray-300 h-[42px]">Hinzufügen</button>
             <% end %>

             <div class="w-1/2 border-l pl-4 border-gray-300">
                 <label class="block text-xs font-medium text-gray-500 mb-1">Aufrunden auf (Total)</label>
                 <input type="number" id="tip_target_total" step="0.05" class="w-full border-gray-300 rounded p-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Total...">
             </div>
         </div>
      </div>
      <% end %>

      <div class="flex justify-between items-end border-t pt-4">
        <span class="text-gray-900 font-bold text-2xl">Total</span>
        <span class="text-5xl font-bold text-[#2C2C2C]" id="final_total_display"><%= number_to_currency(@total, unit: '') %></span>
      </div>

      <!-- Payment Actions -->
      <%= form_with url: process_payment_pos_path(@cash_register), method: :post, id: "payment_form", class: "space-y-4" do |form| %>
        <input type="hidden" name="discount_value" id="hidden_discount_value" value="0">
        <input type="hidden" name="discount_type" id="hidden_discount_type" value="fixed">
        <input type="hidden" name="payment_method" id="payment_method" value="">
        <input type="hidden" name="amount_tendered" id="hidden_amount_tendered" value="">
        <input type="hidden" name="voucher_code" id="hidden_voucher_code" value="">
        <input type="hidden" name="voucher_amount" id="hidden_voucher_amount" value="0">

        <div class="grid grid-cols-2 gap-4 mt-8">
           <!-- Barzahlung -->
           <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 cursor-pointer hover:bg-yellow-100 transition" onclick="selectPayment('cash')">
              <h3 class="font-bold text-lg text-yellow-900 mb-2 text-center">Barzahlung</h3>
              <div class="space-y-2">
                 <label class="block text-xs font-medium text-yellow-800">Gegeben</label>
                 <input type="number" id="amount_tendered_input" step="0.01" class="w-full border-yellow-300 rounded p-2 focus:ring-yellow-500 focus:border-yellow-500 bg-white" placeholder="Betrag...">
                 <div class="flex justify-between text-sm font-bold text-yellow-900 pt-1">
                    <span>Rückgeld:</span>
                    <span id="change_display">0.00</span>
                 </div>
              </div>
              <button type="button" id="cash_pay_btn" onclick="submitPayment('cash')" class="w-full mt-4 bg-[#FFD100] hover:bg-yellow-400 text-[#2C2C2C] font-bold py-3 rounded-lg shadow">Bar bezahlen</button>
           </div>

           <!-- Kartenzahlung -->
           <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 cursor-pointer hover:bg-blue-100 transition flex flex-col justify-between" onclick="selectPayment('card')">
               <div>
                  <h3 class="font-bold text-lg text-blue-900 mb-2 text-center">Kartenzahlung</h3>
                  <div class="text-center text-blue-400">
                     <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16 mx-auto">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z" />
                     </svg>
                  </div>
                  <% if @cash_register.terminal_ip.present? %>
                     <div class="text-xs text-blue-600 text-center mt-2">
                        Terminal: <%= @cash_register.terminal_ip %>:<%= @cash_register.terminal_port || 4100 %>
                     </div>
                  <% end %>
               </div>
               <button type="button" id="card_pay_btn" onclick="submitPayment('card')" class="w-full mt-4 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-lg shadow">Karte bezahlen</button>
           </div>
        </div>
      <% end %>
      

    </div>
    </div>
  </div>
</div>

<!-- Credit Card Transaction Dialog -->
<div id="card-payment-modal" class="hidden fixed inset-0 w-full h-full z-[9999] grid place-items-center" style="background-color: rgba(75, 85, 99, 0.5);">
  <div class="bg-white p-8 rounded-2xl shadow-2xl w-full max-w-md border border-gray-100 text-center">
    <div class="mx-auto mb-4 flex items-center justify-center w-16 h-16 rounded-full bg-blue-50 text-blue-600">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-9 h-9 animate-pulse">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z" />
      </svg>
    </div>

    <h3 id="card-payment-modal-message" class="text-xl font-bold text-gray-800 mb-4">Kreditkarten Terminal - in Bearbeitung</h3>

    <div class="my-6 p-4 bg-gray-50 rounded-xl border border-gray-200">
      <div class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Betrag</div>
      <div class="text-4xl font-bold text-[#2C2C2C]">
        CHF <span id="card-payment-modal-amount"><%= number_to_currency(@total, unit: '') %></span>
      </div>
    </div>

    <button type="button" id="card-payment-abort-btn" onclick="abortCardPayment()" class="w-full py-3 px-6 bg-red-600 hover:bg-red-700 text-white font-bold rounded-lg shadow transition">
      Abbruch
    </button>
  </div>
</div>

<!-- Print Receipt Dialog (Quittung Drucken) -->
<div id="print-receipt-modal" class="hidden fixed inset-0 w-full h-full z-[9999] grid place-items-center" style="background-color: rgba(75, 85, 99, 0.5);">
  <div class="bg-white p-8 rounded-2xl shadow-2xl w-full max-w-md border border-gray-100 text-center">
    <div class="mx-auto mb-4 flex items-center justify-center w-16 h-16 rounded-full bg-green-50 text-green-600">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-9 h-9">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5Zm-3 0h.008v.008H15V10.5Z" />
      </svg>
    </div>

    <h3 class="text-2xl font-bold text-gray-800 mb-2">Quittung Drucken</h3>
    <p id="print-receipt-summary" class="text-sm text-gray-500 mb-4">Transaktion erfolgreich abgeschlossen.</p>

    <div class="mb-6">
      <div class="w-full bg-gray-200 rounded-full h-2 overflow-hidden">
        <div id="print-receipt-progress" class="bg-[#FFD100] h-2 transition-all duration-1000 ease-linear" style="width: 100%;"></div>
      </div>
      <div class="text-xs text-gray-400 mt-1">Schliesst automatisch in <span id="print-receipt-countdown">5</span>s</div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <button type="button" id="print-receipt-cancel-btn" onclick="cancelPrintReceipt()" class="w-full py-3 px-6 bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold rounded-lg transition">
        Abbrechen
      </button>
      <button type="button" id="print-receipt-confirm-btn" onclick="confirmPrintReceipt()" class="w-full py-3 px-6 bg-[#FFD100] hover:bg-yellow-400 text-[#2C2C2C] font-bold rounded-lg shadow transition">
        Drucken
      </button>
    </div>
  </div>
</div>

<script>
(() => {
  const subtotal = <%= @total %>;
  let voucherTotal = 0;
  let currentTotal = subtotal;

  const discountInput = document.getElementById('discount_value');
  const discountRadios = document.querySelectorAll('input[name="discount_type"]');
  const discountDisplay = document.getElementById('discount_display');
  const finalTotalDisplay = document.getElementById('final_total_display');
  const amountTenderedInput = document.getElementById('amount_tendered_input');
  const changeDisplay = document.getElementById('change_display');

  // Hidden inputs
  const hiddenDiscountValue = document.getElementById('hidden_discount_value');
  const hiddenDiscountType = document.getElementById('hidden_discount_type');
  const hiddenPaymentMethod = document.getElementById('payment_method');
  const hiddenAmountTendered = document.getElementById('hidden_amount_tendered');
  
  const paymentForm = document.getElementById('payment_form');
  const cardModal = document.getElementById('card-payment-modal');
  const cardModalAmount = document.getElementById('card-payment-modal-amount');
  const cardAbortBtn = document.getElementById('card-payment-abort-btn');
  const cardPayBtn = document.getElementById('card_pay_btn');
  const cashPayBtn = document.getElementById('cash_pay_btn');

  const printModal = document.getElementById('print-receipt-modal');
  const printSummary = document.getElementById('print-receipt-summary');
  const printCountdown = document.getElementById('print-receipt-countdown');
  const printProgress = document.getElementById('print-receipt-progress');
  const printConfirmBtn = document.getElementById('print-receipt-confirm-btn');
  const printCancelBtn = document.getElementById('print-receipt-cancel-btn');

  let abortRequested = false;
  let abortInFlight = false;
  let cardTxActive = false;
  let cashTxActive = false;

  let pendingReceiptData = null;
  let pendingRedirectUrl = "<%= pos_path(@cash_register) %>";
  let printTimeoutId = null;
  let printIntervalId = null;
  let printInFlight = false;

  function getCsrfToken() {
    const meta = document.querySelector('meta[name="csrf-token"]');
    return meta ? meta.content : '';
  }

  function openCardPaymentModal(amount) {
    if (cardModalAmount) {
      cardModalAmount.textContent = amount.toFixed(2);
    }
    if (cardAbortBtn) {
      cardAbortBtn.disabled = false;
      cardAbortBtn.textContent = 'Abbruch';
      cardAbortBtn.classList.remove('opacity-75', 'cursor-wait');
    }
    if (cardModal) {
      cardModal.classList.remove('hidden');
    }
  }

  function closeCardPaymentModal() {
    if (cardModal) {
      cardModal.classList.add('hidden');
    }
    if (cardPayBtn) {
      cardPayBtn.disabled = false;
      cardPayBtn.textContent = 'Karte bezahlen';
      cardPayBtn.classList.remove('opacity-75', 'cursor-wait');
    }
  }

  function clearPrintTimers() {
    if (printTimeoutId) {
      clearTimeout(printTimeoutId);
      printTimeoutId = null;
    }
    if (printIntervalId) {
      clearInterval(printIntervalId);
      printIntervalId = null;
    }
  }

  function closePrintReceiptModal() {
    clearPrintTimers();
    if (printModal) {
      printModal.classList.add('hidden');
    }
  }

  function openPrintReceiptModal(receiptData, redirectUrl, resultMessage) {
    pendingReceiptData = receiptData || null;
    pendingRedirectUrl = redirectUrl || "<%= pos_path(@cash_register) %>";
    printInFlight = false;

    if (printSummary) {
      printSummary.textContent = resultMessage || 'Transaktion erfolgreich abgeschlossen.';
    }
    if (printConfirmBtn) {
      printConfirmBtn.disabled = false;
      printConfirmBtn.textContent = 'Drucken';
      printConfirmBtn.classList.remove('opacity-75', 'cursor-wait');
    }
    if (printCancelBtn) {
      printCancelBtn.disabled = false;
    }

    let remainingSeconds = 5;
    if (printCountdown) printCountdown.textContent = String(remainingSeconds);
    if (printProgress) {
      printProgress.style.transition = 'none';
      printProgress.style.width = '100%';
    }

    if (printModal) {
      printModal.classList.remove('hidden');
    }

    // Trigger smooth progress bar shrink
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        if (printProgress) {
          printProgress.style.transition = 'width 5s linear';
          printProgress.style.width = '0%';
        }
      });
    });

    clearPrintTimers();
    printIntervalId = setInterval(() => {
      remainingSeconds = Math.max(0, remainingSeconds - 1);
      if (printCountdown) printCountdown.textContent = String(remainingSeconds);
    }, 1000);

    printTimeoutId = setTimeout(() => {
      closePrintReceiptModal();
      window.location.href = pendingRedirectUrl;
    }, 5000);
  }

  window.cancelPrintReceipt = function() {
    if (printInFlight) return;
    closePrintReceiptModal();
    window.location.href = pendingRedirectUrl;
  };

  window.confirmPrintReceipt = function() {
    if (printInFlight) return;
    printInFlight = true;
    clearPrintTimers();

    if (printConfirmBtn) {
      printConfirmBtn.disabled = true;
      printConfirmBtn.textContent = 'Drucke...';
      printConfirmBtn.classList.add('opacity-75', 'cursor-wait');
    }
    if (printCancelBtn) {
      printCancelBtn.disabled = true;
    }

    fetch("<%= print_receipt_pos_path(@cash_register) %>", {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json',
        'X-CSRF-Token': getCsrfToken()
      },
      body: JSON.stringify({ receipt_data: pendingReceiptData || {} }),
      credentials: 'same-origin'
    })
    .then(async (response) => {
      let data = {};
      try {
        data = await response.json();
      } catch (_) {}
      return { ok: response.ok, data };
    })
    .then(({ ok, data }) => {
      closePrintReceiptModal();
      if (!ok || !data.success) {
        const errMsg = data.result_message || 'Druckfehler beim Quittungsdruck.';
        showPosFlash(errMsg, 'alert');
        setTimeout(() => {
          window.location.href = pendingRedirectUrl;
        }, 2000);
        return;
      }
      window.location.href = pendingRedirectUrl;
    })
    .catch((err) => {
      closePrintReceiptModal();
      showPosFlash('Drucker-Verbindungsfehler: ' + err.message, 'alert');
      setTimeout(() => {
        window.location.href = pendingRedirectUrl;
      }, 2000);
    });
  };

  function calculate() {
    let discVal = 0;
    let type = 'fixed';

    if (discountInput) {
        discVal = parseFloat(discountInput.value) || 0;
        let checkedRadio = document.querySelector('input[name="discount_type"]:checked');
        if (checkedRadio) type = checkedRadio.value;
    }
    
    let discAmount = 0;

    if (type === 'percent') {
      discAmount = subtotal * (discVal / 100.0);
    } else {
      discAmount = discVal;
    }

    let unroundedTotal = Math.max(0, subtotal - discAmount - voucherTotal);
    currentTotal = Math.round(unroundedTotal * 20) / 20;
    
    // Update UI
    if (discountDisplay) discountDisplay.textContent = '- ' + discAmount.toFixed(2);
    if (finalTotalDisplay) finalTotalDisplay.textContent = currentTotal.toFixed(2);

    // Update Hidden inputs
    if (hiddenDiscountValue) hiddenDiscountValue.value = discVal;
    if (hiddenDiscountType) hiddenDiscountType.value = type;

    // Recalculate Change
    calculateChange();
  }
  
  function calculateChange() {
     if (!amountTenderedInput) return;
     let tendered = parseFloat(amountTenderedInput.value) || 0;
     let change = Math.max(0, tendered - currentTotal);
     if (changeDisplay) changeDisplay.textContent = change.toFixed(2);
     if (hiddenAmountTendered) hiddenAmountTendered.value = tendered;
  }

  if (discountInput) {
      discountInput.addEventListener('input', calculate);
      discountRadios.forEach(radio => radio.addEventListener('change', calculate));
  }
  if (amountTenderedInput) {
      amountTenderedInput.addEventListener('input', calculateChange);
  }
  
  const tipAmount = document.getElementById('tip_amount');
  const tipTargetTotal = document.getElementById('tip_target_total');
  
  if (tipTargetTotal && tipAmount) {
     tipTargetTotal.addEventListener('input', function() {
        let target = parseFloat(this.value) || 0;
        // Use currentTotal which includes discounts
        let diff = target - currentTotal;
        
        if (diff < 0) diff = 0;
        
        tipAmount.value = diff.toFixed(2);
     });
  }
  
  window.redeemVoucher = function() {
      const input = document.getElementById('voucher_input');
      const val = parseFloat(input.value) || 0;
      
      if (val > 0) {
          voucherTotal += val;
          document.getElementById('hidden_voucher_amount').value = voucherTotal;
          
          const vRow = document.getElementById('vouchers_summary_row');
          const vDisp = document.getElementById('vouchers_display');
          
          if (vRow) vRow.classList.remove('hidden');
          if (vDisp) vDisp.textContent = voucherTotal.toFixed(2);
          
          input.value = '';
          calculate();
      }
  }

  window.submitPayment = function(method) {
      if (method === 'cash') {
          if (!amountTenderedInput.value) {
              amountTenderedInput.value = currentTotal.toFixed(2);
              if (hiddenAmountTendered) hiddenAmountTendered.value = currentTotal.toFixed(2);
              if (changeDisplay) changeDisplay.textContent = '0.00';
          }
          
          let tendered = parseFloat(amountTenderedInput.value) || 0;
          if (tendered < currentTotal) {
              alert("Betrag ist weniger als das Total!");
              return;
          }
      }
      
      hiddenPaymentMethod.value = method;
      if (method === 'card') {
          if (cardTxActive) return;
          cardTxActive = true;
          abortRequested = false;
          abortInFlight = false;

          if (cardPayBtn) {
              cardPayBtn.disabled = true;
              cardPayBtn.textContent = 'Warte auf Kartenterminal...';
              cardPayBtn.classList.add('opacity-75', 'cursor-wait');
          }

          openCardPaymentModal(currentTotal);

          const formData = new FormData(paymentForm);
          fetch(paymentForm.action, {
              method: 'POST',
              headers: {
                  'Accept': 'application/json',
                  'X-CSRF-Token': getCsrfToken()
              },
              body: formData,
              credentials: 'same-origin'
          })
          .then(async (response) => {
              let data = {};
              try {
                  data = await response.json();
              } catch (_) {}
              return { ok: response.ok, status: response.status, data };
          })
          .then(({ ok, data }) => {
              cardTxActive = false;
              // If the user pressed Abbruch, wait for the abort response instead of closing early
              if (abortRequested) {
                  if (ok && data.success) {
                      closeCardPaymentModal();
                      window.location.href = data.redirect_url || "<%= pos_path(@cash_register) %>";
                  }
                  return;
              }

              closeCardPaymentModal();
              if (ok && data.success) {
                  openPrintReceiptModal(data.receipt_data, data.redirect_url || "<%= pos_path(@cash_register) %>", data.result_message);
              } else {
                  const errMsg = data.result_message || "Kartenzahlung fehlgeschlagen.";
                  showPosFlash(errMsg, "alert");
              }
          })
          .catch((err) => {
              cardTxActive = false;
              if (abortRequested) return;
              closeCardPaymentModal();
              showPosFlash("Verbindungsfehler: " + err.message, "alert");
          });
          return;
      }

      if (cashTxActive) return;
      cashTxActive = true;
      if (cashPayBtn) {
          cashPayBtn.disabled = true;
          cashPayBtn.classList.add('opacity-75', 'cursor-wait');
      }

      const formData = new FormData(paymentForm);
      fetch(paymentForm.action, {
          method: 'POST',
          headers: {
              'Accept': 'application/json',
              'X-CSRF-Token': getCsrfToken()
          },
          body: formData,
          credentials: 'same-origin'
      })
      .then(async (response) => {
          let data = {};
          try {
              data = await response.json();
          } catch (_) {}
          return { ok: response.ok, status: response.status, data };
      })
      .then(({ ok, data }) => {
          cashTxActive = false;
          if (cashPayBtn) {
              cashPayBtn.disabled = false;
              cashPayBtn.classList.remove('opacity-75', 'cursor-wait');
          }
          if (ok && data.success) {
              openPrintReceiptModal(data.receipt_data, data.redirect_url || "<%= pos_path(@cash_register) %>", data.result_message);
          } else {
              const errMsg = data.result_message || "Barzahlung fehlgeschlagen.";
              showPosFlash(errMsg, "alert");
          }
      })
      .catch((err) => {
          cashTxActive = false;
          if (cashPayBtn) {
              cashPayBtn.disabled = false;
              cashPayBtn.classList.remove('opacity-75', 'cursor-wait');
          }
          showPosFlash("Verbindungsfehler: " + err.message, "alert");
      });
  }

  window.abortCardPayment = function() {
      if (abortInFlight) return;
      abortRequested = true;
      abortInFlight = true;

      if (cardAbortBtn) {
          cardAbortBtn.disabled = true;
          cardAbortBtn.classList.add('opacity-75', 'cursor-wait');
      }

      fetch("<%= abort_payment_pos_path(@cash_register) %>", {
          method: 'POST',
          headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/json',
              'X-CSRF-Token': getCsrfToken()
          },
          body: JSON.stringify({}),
          credentials: 'same-origin'
      })
      .then(async (response) => {
          let data = {};
          try {
              data = await response.json();
          } catch (_) {}
          return { ok: response.ok, status: response.status, data };
      })
      .then(({ data }) => {
          abortInFlight = false;
          cardTxActive = false;
          closeCardPaymentModal();
          const msg = data.result_message || "Transaktion abgebrochen.";
          showPosFlash(msg, "alert");
      })
      .catch((err) => {
          abortInFlight = false;
          cardTxActive = false;
          closeCardPaymentModal();
          showPosFlash("Fehler beim Abbruch: " + err.message, "alert");
      });
  }
  
  window.selectPayment = function(method) {
      // Logic to highlight if needed
  }
  window.toggleDiscountCode = function(event) {
      event.preventDefault();
      const section = document.getElementById('discount_code_section');
      const btn = document.getElementById('toggle_discount_code_btn');
      
      if (section.classList.contains('hidden')) {
        section.classList.remove('hidden');
        btn.textContent = "- Code ausblenden";
      } else {
        section.classList.add('hidden');
        btn.textContent = "+ Gutschein Code";
      }
  }
})();
</script>
