<div class="max-w-7xl mx-auto">
  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-3xl text-[#2C2C2C]">Lagerort: <%= @location.name %></h1>
    <div class="space-x-2">
      <%= link_to "Bearbeiten", edit_location_path(@location), class: "bg-gray-200 hover:bg-gray-300 px-4 py-2 rounded text-[#2C2C2C] font-medium" %>
      <%= link_to "Zurück", locations_path, class: "bg-gray-200 hover:bg-gray-300 px-4 py-2 rounded text-[#2C2C2C] font-medium" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <!-- Left Column: Add Stock -->
    <div>
      <div class="bg-white p-6 shadow rounded-lg mb-6">
        <h2 class="text-xl font-bold mb-4">Bestand hinzufügen</h2>
        <!-- Search Form -->
        <%= form_with url: location_path(@location), method: :get, class: "flex gap-2 mb-4" do |form| %>
          <%= form.text_field :search_query, value: (@search_results.present? ? '' : params[:search_query]), class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-[#FFD100] focus:ring-[#FFD100] p-2 border", placeholder: "Barcode scannen, SKU oder Name", autofocus: @search_results.blank? %>
          <%= form.submit "Suchen", class: "bg-[#2C2C2C] text-white px-4 py-2 rounded font-bold hover:bg-black cursor-pointer" %>
        <% end %>

        <!-- Search Results -->
        <% if @search_results.present? %>
          <div class="border border-gray-200 rounded-lg overflow-hidden">
            <ul class="divide-y divide-gray-200">
              <% @search_results.each_with_index do |article, index| %>
                <% if article.variants.any? %>
                   <% article.variants.each do |variant| %>
                      <li class="p-3 hover:bg-gray-50 pl-8 bg-gray-50">
                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                          <div>
                            <p class="font-bold text-sm"><%= article.name %> - <%= variant.name %></p>
                            <p class="text-xs text-gray-500"><%= variant.barcode %> | <%= number_to_currency(variant.price) %></p>
                          </div>
                          <%= form_with url: add_stock_location_path(@location), method: :post, class: "flex items-center gap-2" do |f| %>
                            <%= f.hidden_field :article_id, value: article.id %>
                            <%= f.hidden_field :variant_id, value: variant.id %>
                            <%= f.number_field :quantity, value: 1, min: 1, class: "w-20 rounded border border-gray-300 bg-white text-sm p-1" %>
                            <%= f.submit "Hinzufügen", class: "bg-[#FFD100] text-[#2C2C2C] px-3 py-1 rounded text-sm font-bold hover:bg-yellow-400 cursor-pointer" %>
                          <% end %>
                        </div>
                      </li>
                   <% end %>
                <% else %>
                    <li class="p-3 hover:bg-gray-50">
                      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                        <div>
                          <p class="font-bold text-sm"><%= article.name %></p>
                          <p class="text-xs text-gray-500"><%= article.sku %> | <%= article.barcode %></p>
                        </div>
                        <%= form_with url: add_stock_location_path(@location), method: :post, class: "flex items-center gap-2" do |f| %>
                          <%= f.hidden_field :article_id, value: article.id %>
                          <%= f.number_field :quantity, value: 1, min: 1, class: "w-20 rounded border border-gray-300 bg-white text-sm p-1", autofocus: (index == 0), onfocus: "this.select()" %>
                          <%= f.submit "Hinzufügen", class: "bg-[#FFD100] text-[#2C2C2C] px-3 py-1 rounded text-sm font-bold hover:bg-yellow-400 cursor-pointer" %>
                        <% end %>
                      </div>
                    </li>
                <% end %>
              <% end %>
            </ul>
          </div>
        <% elsif params[:search_query].present? %>
          <p class="text-gray-500 text-sm mt-2">Keine Artikel gefunden.</p>
        <% end %>
      </div>
    </div>

    <!-- Right Column: Current Inventory -->
    <div>
      <h2 class="text-xl font-bold mb-4">Aktueller Bestand</h2>
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <% if @stocks.any? %>
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Artikel</th>
                <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Menge</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @stocks.each do |stock| %>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-medium text-gray-900">
                      <% if stock.variant %>
                         <%= stock.article.name %> - <span class="text-gray-600 italic"><%= stock.variant.name %></span>
                      <% else %>
                         <%= stock.article.name %>
                      <% end %>
                    </div>
                    <div class="text-xs text-gray-500">
                        <%= stock.variant ? stock.variant.barcode : stock.article.sku %>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right text-sm text-gray-900 font-bold">
                    <%= stock.quantity %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="p-6 text-center text-gray-500">
            Kein Bestand an diesem Lagerort erfasst.
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
