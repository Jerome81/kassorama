<%= form_with(model: cash_register, class: "contents") do |form| %>
  <% if cash_register.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mt-3">
      <h2><%= cash_register.errors.count == 1 ? "1 Fehler verhinderte das Speichern:" : "#{cash_register.errors.count} Fehler verhinderten das Speichern:" %></h2>

      <ul>
        <% cash_register.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: "block shadow rounded-md border border-gray-200 outline-none px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :status %>
    <%= form.select :status, [['Aktiv', 'active'], ['Inaktiv', 'inactive']], {}, class: "block shadow rounded-md border border-gray-200 outline-none px-3 py-2 mt-2 w-full" %>
  </div>
  <div class="my-5">
    <%= form.label :stock_location_id, "Bestand von Lagerort nehmen" %>
    <%= form.collection_select :stock_location_id, Location.all, :id, :name, { include_blank: "Lagerort auswählen" }, class: "block shadow rounded-md border border-gray-200 outline-none px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :amount, "Aktueller Bargeldbestand" %>
    <%= form.number_field :amount, step: 0.01, class: "block shadow rounded-md border border-gray-200 outline-none px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :precreated_tabs, "Vorgefertigte Tabs (komma-seperierte Liste)" %>
    <%= form.text_field :precreated_tabs, class: "block shadow rounded-md border border-gray-200 outline-none px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5 grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="md:col-span-2">
      <%= form.label :terminal_ip, "Kartenterminal IP-Adresse (oder 'mock' für Simulator)" %>
      <%= form.text_field :terminal_ip, placeholder: "z.B. 192.168.1.50 oder mock", class: "block shadow rounded-md border border-gray-200 outline-none px-3 py-2 mt-2 w-full" %>
    </div>
    <div>
      <%= form.label :terminal_port, "Kartenterminal Port (OPI)" %>
      <%= form.number_field :terminal_port, value: (cash_register.terminal_port.nil? || cash_register.terminal_port == 20007 ? 4100 : cash_register.terminal_port), class: "block shadow rounded-md border border-gray-200 outline-none px-3 py-2 mt-2 w-full" %>
    </div>
  </div>

  <div class="my-5 grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="md:col-span-2">
      <%= form.label :printer_ip, "Kassen-/Drucker IP-Adresse (oder 'mock' für Simulator)" %>
      <%= form.text_field :printer_ip, placeholder: "z.B. 192.168.1.51 oder mock", class: "block shadow rounded-md border border-gray-200 outline-none px-3 py-2 mt-2 w-full" %>
    </div>
    <div>
      <%= form.label :printer_port, "Drucker Port" %>
      <%= form.number_field :printer_port, value: (cash_register.printer_port || 8081), class: "block shadow rounded-md border border-gray-200 outline-none px-3 py-2 mt-2 w-full" %>
    </div>
  </div>

  <div class="my-8">
    <h3 class="font-bold text-xl mb-4 text-[#2C2C2C]">Bereiche</h3>
    <div id="sections">
      <%= form.fields_for :sections do |section_form| %>
        <%= render "section_fields", f: section_form %>
      <% end %>
    </div>
    <div class="mt-2">
       <!-- Note: For dynamic adding, we would need Stimulus. For now, we rely on editing existing or manually handling additions via Rails conventions if we added a button, but let's at least show existing ones and allow editing/destroying. To simplify, allow adding 3 new ones if none exist or manually. -->
       <% if cash_register.sections.empty? %>
          <p class="text-sm text-gray-500 italic mb-2">Noch keine Bereiche. Speichern zum Erstellen.</p>
       <% end %>
    </div>
  </div>

  <div class="inline">
    <%= form.submit class: "rounded-lg py-3 px-5 bg-[#FFD100] text-[#2C2C2C] inline-block font-bold cursor-pointer" %>
  </div>
<% end %>
